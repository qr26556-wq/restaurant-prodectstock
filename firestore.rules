rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function rootId() {
      return profile().restaurantId;
    }

    function activeUser() {
      return signedIn() && profile().active != false;
    }

    function ownerOf(restId) {
      return signedIn() &&
        get(/databases/$(database)/documents/restaurants/$(restId)).data.ownerUid == request.auth.uid;
    }

    function staffOf(restId) {
      return activeUser() && (
        profile().restaurantId == restId ||
        (
          profile().branchId == restId &&
          get(/databases/$(database)/documents/restaurants/$(profile().restaurantId)/branches/$(restId)).data.active != false
        ) ||
        ownerOf(restId)
      );
    }

    function adminOf(restId) {
      return staffOf(restId) &&
        (profile().role == 'admin' || ownerOf(restId));
    }

    function managerOf(restId) {
      return staffOf(restId) && profile().role == 'manager';
    }

    function adminManagerOf(restId) {
      return adminOf(restId) || managerOf(restId);
    }

    function multiSettings(restId) {
      return get(/databases/$(database)/documents/restaurants/$(restId)/settings/general).data;
    }

    function multiActive(restId) {
      return multiSettings(restId).plan == 'multibranch_lifetime' ||
        (
          multiSettings(restId).plan == 'multibranch' &&
          multiSettings(restId).planExpiresAt != null &&
          multiSettings(restId).planExpiresAt > request.time
        );
    }

    function productOwner() {
      return signedIn() && request.auth.token.email == 'qraza2376@gmail.com';
    }

    // ---------------------------------------------------------
    // USER PROFILES
    // ---------------------------------------------------------
    match /users/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid ||
        (profile().role == 'admin' && profile().active != false &&
         profile().restaurantId == resource.data.restaurantId)
      );

      // New admin owner, normal staff code, or reusable branch code.
      allow create: if
        (
          signedIn() && request.auth.uid == uid &&
          request.resource.data.active == true &&
          request.resource.data.role == 'admin' &&
          request.resource.data.restaurantId is string &&
          get(/databases/$(database)/documents/restaurants/$(request.resource.data.restaurantId)).data.ownerUid == request.auth.uid
        )
        ||
        (
          signedIn() && request.auth.uid == uid &&
          request.resource.data.active == true &&
          request.resource.data.role in ['admin','manager','cashier'] &&
          request.resource.data.joinedViaCode is string &&
          get(/databases/$(database)/documents/staffCodes/$(request.resource.data.joinedViaCode)).data.used == false &&
          get(/databases/$(database)/documents/staffCodes/$(request.resource.data.joinedViaCode)).data.role == request.resource.data.role &&
          get(/databases/$(database)/documents/staffCodes/$(request.resource.data.joinedViaCode)).data.restaurantId == request.resource.data.restaurantId
        )
        ||
        (
          signedIn() && request.auth.uid == uid &&
          request.resource.data.active == true &&
          request.resource.data.role == 'cashier' &&
          request.resource.data.joinedViaBranchCode is string &&
          get(/databases/$(database)/documents/branchCodes/$(request.resource.data.joinedViaBranchCode)).data.active == true &&
          get(/databases/$(database)/documents/branchCodes/$(request.resource.data.joinedViaBranchCode)).data.rootRestaurantId == request.resource.data.restaurantId &&
          get(/databases/$(database)/documents/branchCodes/$(request.resource.data.joinedViaBranchCode)).data.branchRestaurantId == request.resource.data.branchId
        )
        ||
        (
          signedIn() && profile().role == 'admin' && profile().active != false &&
          request.resource.data.restaurantId == rootId() &&
          request.resource.data.role in ['admin','manager','cashier'] &&
          request.resource.data.active == true
        );

      allow update, delete: if signedIn() &&
        profile().role == 'admin' && profile().active != false &&
        profile().restaurantId == resource.data.restaurantId;
    }

    // ---------------------------------------------------------
    // STAFF CODES (one-time)
    // ---------------------------------------------------------
    match /staffCodes/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && profile().role == 'admin' &&
        profile().active != false && rootId() == request.resource.data.restaurantId;

      allow update: if
        (signedIn() && profile().role == 'admin' && profile().active != false &&
         rootId() == resource.data.restaurantId)
        ||
        (signedIn() && resource.data.used == false &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used','usedBy','usedByName','usedAt']) &&
         request.resource.data.used == true && request.resource.data.usedBy == request.auth.uid);

      allow delete: if signedIn() && profile().role == 'admin' &&
        profile().active != false && rootId() == resource.data.restaurantId;
    }

    // ---------------------------------------------------------
    // REUSABLE BRANCH CODES (multiple devices)
    // ---------------------------------------------------------
    match /branchCodes/{code} {
      allow get: if signedIn();
      allow list: if signedIn() && profile().role == 'admin' && profile().active != false && rootId() == resource.data.rootRestaurantId;

      allow create: if signedIn() && profile().role == 'admin' &&
        profile().active != false && rootId() == request.resource.data.rootRestaurantId &&
        multiActive(rootId());

      allow update: if signedIn() && profile().role == 'admin' &&
        profile().active != false && rootId() == resource.data.rootRestaurantId;

      allow delete: if signedIn() && profile().role == 'admin' &&
        profile().active != false && rootId() == resource.data.rootRestaurantId;
    }

    // ---------------------------------------------------------
    // PLAN / ACTIVATION CODES
    // ---------------------------------------------------------
    match /licenseCodes/{code} {
      allow get: if signedIn();
      allow list: if productOwner();
      allow create: if productOwner();

      allow update: if signedIn() &&
        resource.data.used == false &&
        adminOf(request.resource.data.usedByRestaurantId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'used','usedByRestaurantId','usedByRestaurantName','usedAt'
        ]) &&
        request.resource.data.used == true;

      allow delete: if productOwner() && resource.data.used == false;
    }

    // ---------------------------------------------------------
    // RESTAURANTS
    // ---------------------------------------------------------
    match /restaurants/{restId} {
      allow read: if staffOf(restId) || ownerOf(restId);
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if adminOf(restId);
      allow delete: if false;

      match /branches/{branchId} {
        allow read: if adminOf(restId) && restId == rootId();
        allow create: if adminOf(restId) && restId == rootId() &&
          multiActive(restId) && request.resource.data.active == true;
        allow update: if adminOf(restId) && restId == rootId() &&
          multiActive(restId);
        allow delete: if adminOf(restId) && restId == rootId();
      }

      match /categories/{id} {
        allow read: if staffOf(restId);
        allow create, update, delete: if adminManagerOf(restId);
      }

      match /products/{id} {
        allow read: if staffOf(restId);
        allow create, delete: if adminManagerOf(restId);
        allow update: if adminManagerOf(restId) ||
          (staffOf(restId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']));
      }

      match /tables/{id} {
        allow read: if staffOf(restId);
        allow create, delete: if adminManagerOf(restId);
        allow update: if staffOf(restId);
      }

      match /orders/{id} {
        allow read, create, update: if staffOf(restId);
        allow delete: if adminOf(restId);
      }

      match /sales/{id} {
        allow read, create: if staffOf(restId);
        allow update: if adminManagerOf(restId);
        allow delete: if adminOf(restId);
      }

      match /customers/{id} {
        allow read, create, update: if staffOf(restId);
        allow delete: if adminManagerOf(restId);
      }

      match /settings/{id} {
        allow read: if staffOf(restId);
        allow write: if adminManagerOf(restId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
